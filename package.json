{
  "name": "memorabilia-static-api",
  "version": "1.0.0",
  "private": true,
  "description": "Wayback Machine scraper and static JSON API for the Memorabilia cartoon archive.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "scrape": "node scripts/scrape.mjs",
    "scrape:debug": "DEBUG=1 node scripts/scrape.mjs",
    "scrape:dry": "DRY_RUN=1 node scripts/scrape.mjs",
    "download:images": "node scripts/download-images.mjs",
    "prune:emoji-images": "node scripts/download-images.mjs --prune-emojis",
    "fix:characters": "node scripts/fix-croatian-characters.mjs",
    "fix:characters:write": "node scripts/fix-croatian-characters.mjs --write",
    "repair:encoding": "node scripts/repair-encoding.mjs",
    "repair:encoding:write": "node scripts/repair-encoding.mjs --write",
    "api:build": "node scripts/build.mjs",
    "api:remove-links": "node scripts/remove-faulty-links.mjs",
    "build": "pnpm run validate && panda build && next build && node scripts/prepare-pages.mjs",
    "validate": "node scripts/validate.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "panda build && next dev",
    "preview": "npx serve out",
    "vercel-build": "pnpm run build",
    "youtube:sync": "node scripts/sync-youtube.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "cheerio": "^1.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0-canary.105",
    "next-intl": "^4.3.9",
    "next-themes": "^0.4.6",
    "p-limit": "^6.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@chakra-ui/panda-preset": "^3.36.1",
    "@pandacss/dev": "2.0.0-beta.11",
    "@pandacss/preset-base": "2.0.0-beta.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dictionary-hr": "^2.0.0",
    "hunspell-wasm": "^0.3.0",
    "serve": "^14.2.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
