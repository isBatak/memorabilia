{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/v1", "destination": "/api/v1/index.json" },
    { "source": "/api/v1/cartoons/:slug", "destination": "/api/v1/cartoons/:slug.json" },
    { "source": "/api/v1/series/:slug", "destination": "/api/v1/series/:slug.json" },
    { "source": "/api/v1/movies/:slug", "destination": "/api/v1/movies/:slug.json" }
  ]
}
